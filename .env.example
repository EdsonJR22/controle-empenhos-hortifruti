# URL pública usada nos metadados de compartilhamento.
# Exemplo: https://controle-empenhos-hortifruti.seu-subdominio.workers.dev
NEXT_PUBLIC_SITE_URL=

# Credenciais de desenvolvimento. Copie estas chaves para .dev.vars e nunca
# versione os valores reais. AUTH_SECRET deve ter pelo menos 32 caracteres.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
