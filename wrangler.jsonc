{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "controle-empenhos-hortifruti",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "controle-empenhos-hortifruti-db",
      "database_id": "18c548ab-1228-4f97-95fa-4c0f061a228c",
      "migrations_dir": "drizzle"
    }
  ],
  "secrets": {
    "required": ["AUTH_USERNAME", "AUTH_PASSWORD", "AUTH_SECRET"]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1562575727",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
